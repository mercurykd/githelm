{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "Node",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "noEmit": false,
    "rootDir": "src/webview",
    "outDir": "dist/webview-client",
    "sourceMap": false
  },
  "include": [
    "src/webview/client/**/*.ts",
    "src/webview/selection.ts",
    "src/webview/protocol.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
