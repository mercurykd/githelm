    "vscode:prepublish": "npm run build",
    "build": "tsc -p tsconfig.dist.json && node scripts/copy-shims.cjs",
    "watch": "tsc -p tsconfig.dist.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node scripts/validate-manifest.cjs",
    "build:tests": "tsc -p tsconfig.build.json",
    "test": "npm run build && npm run build:tests && npm run validate && node --test --experimental-test-isolation=none \"build/test/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0"
  }
