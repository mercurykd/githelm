      {
        "command": "githelm.status.stage",
        "key": "s",
        "when": "editorTextFocus && resourceScheme == 'githelm' && githelm.view == 'status'"
      },
      {
        "command": "githelm.status.unstage",
        "key": "u",
        "when": "editorTextFocus && resourceScheme == 'githelm' && githelm.view == 'status'"
      },
      {
        "command": "githelm.status.stageAll",
