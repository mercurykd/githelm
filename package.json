{
  "name": "githelm",
  "displayName": "Git Helm",
  "description": "Keyboard-driven git client for VS Code: status buffer, log graph, staging, diffs, stash, rebase and worktrees — GitSavvy-style, one screen per task.",
  "version": "0.0.7",
  "publisher": "mercurykd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mercurykd/githelm.git"
  },
  "bugs": {
    "url": "https://github.com/mercurykd/githelm/issues"
  },
  "homepage": "https://github.com/mercurykd/githelm#readme",
  "icon": "media/icon.png",
  "keywords": [
    "git",
    "git-client",
    "git-gui",
    "git-dashboard",
    "git-graph",
    "git-history",
    "git-status",
    "log-graph",
    "staging",
    "commit",
    "stash",
    "rebase",
    "worktree",
    "diffs",
    "keyboard-driven",
    "scm",
    "vim"
  ],
  "galleryBanner": {
    "color": "#1b1f24",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "colors": [
      {
        "id": "githelm.added",
        "description": "Git Helm: добавленные файлы и строки",
        "defaults": {
          "dark": "#92a271",
          "light": "#5c6744",
          "highContrast": "#92a271",
          "highContrastLight": "#5c6744"
        }
      },
      {
        "id": "githelm.modified",
        "description": "Git Helm: изменённые файлы",
        "defaults": {
          "dark": "#d8b884",
          "light": "#7e5d28",
          "highContrast": "#d8b884",
          "highContrastLight": "#7e5d28"
        }
      },
      {
        "id": "githelm.deleted",
        "description": "Git Helm: удалённые файлы и строки",
        "defaults": {
          "dark": "#c56f62",
          "light": "#9d4a3e",
          "highContrast": "#c56f62",
          "highContrastLight": "#9d4a3e"
        }
      },
      {
        "id": "githelm.conflict",
        "description": "Git Helm: конфликты",
        "defaults": {
          "dark": "#d18b5f",
          "light": "#93522a",
          "highContrast": "#d18b5f",
          "highContrastLight": "#93522a"
        }
      },
      {
        "id": "githelm.hash",
        "description": "Git Helm: хеши коммитов",
        "defaults": {
          "dark": "#c9a87c",
          "light": "#7d5d33",
          "highContrast": "#c9a87c",
          "highContrastLight": "#7d5d33"
        }
      },
      {
        "id": "githelm.date",
        "description": "Git Helm: даты",
        "defaults": {
          "dark": "#aca08e",
          "light": "#6d6150",
          "highContrast": "#aca08e",
          "highContrastLight": "#6d6150"
        }
      },
      {
        "id": "githelm.author",
        "description": "Git Helm: авторы",
        "defaults": {
          "dark": "#ce7865",
          "light": "#a14733",
          "highContrast": "#ce7865",
          "highContrastLight": "#a14733"
        }
      },
      {
        "id": "githelm.refs",
        "description": "Git Helm: ветки и ссылки",
        "defaults": {
          "dark": "#a8a189",
          "light": "#68624d",
          "highContrast": "#a8a189",
          "highContrastLight": "#68624d"
        }
      },
      {
        "id": "githelm.upstream",
        "description": "Git Helm: сопоставление ветки с её remote (origin/main и отставание)",
        "defaults": {
          "dark": "#ce7865",
          "light": "#a14733",
          "highContrast": "#ce7865",
          "highContrastLight": "#a14733"
        }
      },
      {
        "id": "githelm.graph",
        "description": "Git Helm: линии графа",
        "defaults": {
          "dark": "#8a8073",
          "light": "#686157",
          "highContrast": "#8a8073",
          "highContrastLight": "#686157"
        }
      },
      {
        "id": "githelm.hunk",
        "description": "Git Helm: заголовки хунков",
        "defaults": {
          "dark": "#a89297",
          "light": "#745d62",
          "highContrast": "#a89297",
          "highContrastLight": "#745d62"
        }
      },
      {
        "id": "githelm.meta",
        "description": "Git Helm: второстепенный текст",
        "defaults": {
          "dark": "#9f958a",
          "light": "#6a6157",
          "highContrast": "#9f958a",
          "highContrastLight": "#6a6157"
        }
      },
      {
        "id": "githelm.path",
        "description": "Git Helm: путь файла в списках",
        "defaults": {
          "dark": "#cfc4b6",
          "light": "#705f4a",
          "highContrast": "#cfc4b6",
          "highContrastLight": "#705f4a"
        }
      },
      {
        "id": "githelm.section",
        "description": "Git Helm: заголовки секций",
        "defaults": {
          "dark": "#c6a888",
          "light": "#7c5d3b",
          "highContrast": "#c6a888",
          "highContrastLight": "#7c5d3b"
        }
      },
      {
        "id": "githelm.staged",
        "description": "Git Helm: заголовок секции staged",
        "defaults": {
          "dark": "#a9b98a",
          "light": "#5a683e",
          "highContrast": "#a9b98a",
          "highContrastLight": "#5a683e"
        }
      },
      {
        "id": "githelm.unstaged",
        "description": "Git Helm: заголовок секции unstaged",
        "defaults": {
          "dark": "#cda276",
          "light": "#835a30",
          "highContrast": "#cda276",
          "highContrastLight": "#835a30"
        }
      },
      {
        "id": "githelm.untracked",
        "description": "Git Helm: заголовок секции untracked",
        "defaults": {
          "dark": "#ce7865",
          "light": "#a14733",
          "highContrast": "#ce7865",
          "highContrastLight": "#a14733"
        }
      },
      {
        "id": "githelm.remotes",
        "description": "Git Helm: заголовок remotes",
        "defaults": {
          "dark": "#c6ad78",
          "light": "#766032",
          "highContrast": "#c6ad78",
          "highContrastLight": "#766032"
        }
      },
      {
        "id": "githelm.worktrees",
        "description": "Git Helm: заголовок worktrees (тот же цвет, что у remotes: два блока стоят одной колонкой)",
        "defaults": {
          "dark": "#c6ad78",
          "light": "#766032",
          "highContrast": "#c6ad78",
          "highContrastLight": "#766032"
        }
      },
      {
        "id": "githelm.branch",
        "description": "Git Helm: текущая ветка",
        "defaults": {
          "dark": "#9cad83",
          "light": "#596744",
          "highContrast": "#9cad83",
          "highContrastLight": "#596744"
        }
      },
      {
        "id": "githelm.help",
        "description": "Git Helm: подсказки по клавишам",
        "defaults": {
          "dark": "#78736c",
          "light": "#8b867e",
          "highContrast": "#78736c",
          "highContrastLight": "#8b867e"
        }
      },
      {
        "id": "githelm.rule",
        "description": "Git Helm: подчёркивание под подсказками",
        "defaults": {
          "dark": "#665f59",
          "light": "#a09892",
          "highContrast": "#665f59",
          "highContrastLight": "#a09892"
        }
      }
    ],
    "commands": [
      {
        "command": "githelm.status.open",
        "title": "Git Helm: Status"
      },
      {
        "command": "githelm.file.actions",
        "title": "Git Helm: Actions for Current File"
      },
      {
        "command": "githelm.repo.init",
        "title": "Git Helm: Initialize Repository"
      },
      {
        "command": "githelm.diff.walkPrev",
        "title": "Git Helm: Previous Commit in Diff",
        "icon": "$(arrow-left)",
        "enablement": "githelm.diffPrev"
      },
      {
        "command": "githelm.diff.walkNext",
        "title": "Git Helm: Next Commit in Diff",
        "icon": "$(arrow-right)",
        "enablement": "githelm.diffNext"
      },
      {
        "command": "githelm.log.open",
        "title": "Git Helm: Commit History"
      },
      {
        "command": "githelm.branches.open",
        "title": "Git Helm: Branches Screen"
      },
      {
        "command": "githelm.rebase.interactive",
        "title": "Git Helm: Interactive Rebase"
      },
      {
        "command": "githelm.tags.open",
        "title": "Git Helm: Tags"
      },
      {
        "command": "githelm.submodules.open",
        "title": "Git Helm: Submodules"
      },
      {
        "command": "githelm.forge.createPull",
        "title": "Git Helm: Create Pull Request"
      },
      {
        "command": "githelm.language",
        "title": "Git Helm: Interface Language"
      },
      {
        "command": "githelm.actionLog",
        "title": "Git Helm: Action Log"
      },
      {
        "command": "githelm.stash.fileDiff",
        "title": "Git Helm: Diff File in Stash"
      },
      {
        "command": "githelm.commit.fileDiff",
        "title": "Git Helm: Diff File in Commit"
      },
      {
        "command": "githelm.commit.filesAtRef",
        "title": "Git Helm: Open Files at Commit"
      },
      {
        "command": "githelm.conflict.ours",
        "title": "Git Helm: Take Ours"
      },
      {
        "command": "githelm.conflict.theirs",
        "title": "Git Helm: Take Theirs"
      },
      {
        "command": "githelm.conflict.base",
        "title": "Git Helm: Take Base"
      },
      {
        "command": "githelm.conflict.resolve",
        "title": "Git Helm: Mark Resolved"
      },
      {
        "command": "githelm.conflict.mergeEditor",
        "title": "Git Helm: Open Merge Editor"
      }
    ],
    "keybindings": [
      {
        "command": "githelm.status.open",
        "key": "alt+g"
      },
      {
        "command": "githelm.diff.walkPrev",
        "key": "alt+[",
        "when": "editorTextFocus && githelm.diffWalk"
      },
      {
        "command": "githelm.diff.walkNext",
        "key": "alt+]",
        "when": "editorTextFocus && githelm.diffWalk"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "githelm.diff.walkPrev",
          "when": "githelm.diffWalk",
          "group": "navigation@1"
        },
        {
          "command": "githelm.diff.walkNext",
          "when": "githelm.diffWalk",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "githelm.log.open",
          "when": "false"
        },
        {
          "command": "githelm.branches.open",
          "when": "false"
        },
        {
          "command": "githelm.rebase.interactive",
          "when": "false"
        },
        {
          "command": "githelm.tags.open",
          "when": "false"
        },
        {
          "command": "githelm.submodules.open",
          "when": "false"
        },
        {
          "command": "githelm.forge.createPull",
          "when": "false"
        },
        {
          "command": "githelm.actionLog",
          "when": "false"
        },
        {
          "command": "githelm.stash.fileDiff",
          "when": "false"
        },
        {
          "command": "githelm.commit.fileDiff",
          "when": "false"
        },
        {
          "command": "githelm.commit.filesAtRef",
          "when": "false"
        },
        {
          "command": "githelm.conflict.ours",
          "when": "false"
        },
        {
          "command": "githelm.conflict.theirs",
          "when": "false"
        },
        {
          "command": "githelm.conflict.base",
          "when": "false"
        },
        {
          "command": "githelm.conflict.resolve",
          "when": "false"
        },
        {
          "command": "githelm.conflict.mergeEditor",
          "when": "false"
        },
        {
          "command": "githelm.repo.init",
          "when": "false"
        },
        {
          "command": "githelm.diff.walkPrev",
          "when": "false"
        },
        {
          "command": "githelm.diff.walkNext",
          "when": "false"
        }
      ],
      "editor/context": [
        {
          "command": "githelm.diff.walkPrev",
          "when": "githelm.diffWalk",
          "group": "navigation@1"
        },
        {
          "command": "githelm.diff.walkNext",
          "when": "githelm.diffWalk",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Git Helm",
      "properties": {
        "githelm.log.dateFormat": {
          "type": "string",
          "default": "%Y-%m-%d %H:%M",
          "markdownDescription": "Date format for the history screen, passed to `git --date=format:…`."
        },
        "githelm.log.includeAllRefs": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show every ref in the history screen, including custom ones created by other tools (`refs/cline/*`) and `refs/stash`. Off by default: stash WIP/index commits look like branch history."
        },
        "githelm.forge.kind": {
          "type": "string",
          "enum": [
            "auto",
            "github",
            "gitlab"
          ],
          "default": "auto",
          "markdownDescription": "Forge for the pull request list. `auto` reads it from the remote host: a name containing `gitlab` means GitLab, `github` means GitHub. Set it explicitly for a self-hosted host with a neutral name."
        },
        "githelm.forge.githubToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Token for the GitHub API, used only to list open pull requests — a fine-grained token with `Pull requests: read` is enough. Falls back to the `GITHUB_TOKEN` environment variable. Creating a pull request needs no token: that page opens in the browser."
        },
        "githelm.forge.gitlabToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Token for the GitLab API, used only to list open merge requests — a token with `read_api` is enough. Falls back to the `GITLAB_TOKEN` environment variable."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:all",
    "build": "tsc -p tsconfig.dist.json && node scripts/copy-shims.cjs",
    "watch": "tsc -p tsconfig.dist.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node scripts/validate-manifest.cjs",
    "build:tests": "tsc -p tsconfig.build.json",
    "test": "npm run build:all && npm run build:tests && npm run validate && node --test --experimental-test-isolation=none \"build/test/*.test.js\"",
    "build:webview": "tsc -p tsconfig.webview.json",
    "build:all": "npm run clean && npm run build && npm run build:webview",
    "preflight": "node scripts/preflight.cjs",
    "clean": "node scripts/clean.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0"
  }
}
