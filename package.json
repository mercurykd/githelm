    "configuration": {
      "title": "Git Helm",
      "properties": {
        "githelm.log.dateFormat": {
          "type": "string",
          "default": "%Y-%m-%d %H:%M",
          "markdownDescription": "Date format for the history screen, passed to `git --date=format:…`."
        },
        "githelm.ui.hintColumn": {
          "type": "number",
          "default": 94,
          "minimum": 30,
          "markdownDescription": "Column where the right-hand key hints start. A text buffer cannot stick to the viewport edge, so widen this for very wide windows."
        },
        "githelm.log.includeAllRefs": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Show every ref in the history screen, including custom ones created by other tools (`refs/cline/*`) and `refs/stash`. Off by default: stash WIP/index commits look like branch history."
        },
        "githelm.forge.kind": {
          "type": "string",
          "enum": [
            "auto",
            "github",
            "gitlab"
          ],
          "default": "auto",
          "markdownDescription": "Forge for the pull request list. `auto` reads it from the remote host: a name containing `gitlab` means GitLab, `github` means GitHub. Set it explicitly for a self-hosted host with a neutral name."
        },
        "githelm.forge.githubToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Token for the GitHub API, used only to list open pull requests — a fine-grained token with `Pull requests: read` is enough. Falls back to the `GITHUB_TOKEN` environment variable. Creating a pull request needs no token: that page opens in the browser."
        },
        "githelm.forge.gitlabToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Token for the GitLab API, used only to list open merge requests — a token with `read_api` is enough. Falls back to the `GITLAB_TOKEN` environment variable."
        }
      }
    }
