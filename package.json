{
  "name": "githelm",
  "displayName": "Git Helm",
  "description": "Keyboard-driven git client for VS Code: status buffer, log graph, staging, diffs, stash, rebase and worktrees — GitSavvy-style, one screen per task.",
  "version": "0.0.4",
  "publisher": "mercurykd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mercurykd/githelm.git"
  },
  "bugs": {
    "url": "https://github.com/mercurykd/githelm/issues"
  },
  "homepage": "https://github.com/mercurykd/githelm#readme",
  "icon": "media/icon.png",
  "keywords": [
    "git",
    "git-client",
    "git-gui",
    "git-dashboard",
    "git-graph",
    "git-history",
    "git-status",
    "log-graph",
    "staging",
    "commit",
    "stash",
    "rebase",
    "worktree",
    "diffs",
    "keyboard-driven",
    "scm",
    "vim"
  ],
  "galleryBanner": {
    "color": "#1b1f24",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
